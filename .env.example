# ==============================================================================
# DutyLedger (Attendance & Payroll Management) - Environment Configuration
# ==============================================================================

# PostgreSQL Settings (Docker Compose & Local Dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dutyledger_db
POSTGRES_PORT=5435
POSTGRES_HOST=localhost

# Direct Database URL for Prisma (used in local development outside Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/dutyledger_db?schema=public"

# Backend Service
BACKEND_PORT=4500
PORT=4500
NODE_ENV=development
JWT_SECRET=dutyledger_jwt_super_secret_key_2026
JWT_EXPIRES_IN=7d

# Frontend Service
FRONTEND_PORT=3100
VITE_API_BASE_URL=http://localhost:4500

# Email (Nodemailer / SMTP)
SMTP_EMAIL=hr@lucentpolysystems.com
SMTP_PASS=your_smtp_app_password
HR_EMAIL=hr@lucentpolysystems.com

# Cloudinary (Media uploads)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
